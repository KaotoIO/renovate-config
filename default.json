{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 5,
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "renovate",
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Major updates need a decision first: they only get a branch and PR once they are ticked in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "react monorepo",
      "matchPackageNames": [
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackagePatterns": ["eslint"]
    },
    {
      "groupName": "@kie-tools",
      "matchPackagePatterns": ["@kie-tools"]
    },
    {
      "groupName": "@opentelemetry",
      "matchPackagePatterns": ["@opentelemetry"]
    },
    {
      "groupName": "@patternfly",
      "matchPackagePatterns": ["@patternfly"]
    },
    {
      "groupName": "@lerna-lite",
      "matchPackagePatterns": ["@lerna-lite"]
    },
    {
      "extends": "monorepo:storybook",
      "groupName": "storybook monorepo",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor",
        "major"
      ]
    }
  ]
}
