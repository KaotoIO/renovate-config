{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Madrid",
  "configMigration": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ],
  "dependencyDashboard": {
    "osvVulnerabilitySummary": "unresolved"
  },
  "prConcurrentLimit": 5,
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "renovate",
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Major updates need a decision first: they only get a branch and PR once they are ticked in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "react monorepo",
      "matchPackageNames": [
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": ["/eslint/"]
    },
    {
      "groupName": "@patternfly",
      "matchPackageNames": ["/@patternfly/"]
    },
    {
      "groupName": "@lerna-lite",
      "matchPackageNames": ["/@lerna-lite/"]
    },
    {
      "extends": ["monorepo:storybook"],
      "groupName": "storybook monorepo",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor",
        "major"
      ]
    }
  ]
}
